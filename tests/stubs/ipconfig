#!/bin/bash
# Fake ipconfig. STUB_IP / STUB_GATEWAY / STUB_NETWORK_DNS set to "" mean "none".
case $1 in
    getifaddr) ip=${STUB_IP-10.1.2.3}; [ -n "$ip" ] || exit 1; echo "$ip" ;;
    getoption)
        case $3 in
            router) value=${STUB_GATEWAY-172.18.0.1} ;;
            domain_name_server) value=${STUB_NETWORK_DNS-10.10.0.53} ;;
            *) value="" ;;
        esac
        [ -n "$value" ] || exit 1
        echo "$value"
        ;;
    getsummary)
        echo "<dictionary> {"
        echo "  BSSID : 0:11:22:33:44:55"
        [ -n "${STUB_SSID-}" ] && echo "  SSID : $STUB_SSID"
        echo "  InterfaceType : WiFi"
        echo "}"
        ;;
esac
